// Title: Entra ID Password Spray & MFA Fatigue Detection
// MITRE ATT&CK: T1110.003 (Password Spraying), T1621 (Multi-Factor Authentication Request Generation)
// Data Source: SigninLogs
let lookback = 24h;
let failure_threshold = 8;
SigninLogs
| where TimeGenerated >= ago(lookback)
| where ResultType != "0"
| summarize
    FailedAttempts = count(),
    TargetedUsers = dcount(UserPrincipalName),
    UserList = make_set(UserPrincipalName, 15),
    ErrorCodes = make_set(ResultType, 10),
    Applications = make_set(AppDisplayName, 10)
    by IPAddress, Location = tostring(LocationDetails.countryOrRegion), bin(TimeGenerated, 1h)
| where TargetedUsers >= 5 or FailedAttempts >= failure_threshold
| order by FailedAttempts desc, TargetedUsers desc
